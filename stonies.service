[Unit]
Description=Stonies NFC music player
# network-online (not just network) — otherwise the service can start before
# the Pi has an IP and resolve its own address as 127.0.0.1
Wants=network-online.target
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/stonies
ExecStart=/home/pi/stonies/env/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
